 <office:body><office:text>
  <text:tracked-changes text:track-changes="true">
   <text:changed-region xml:id="ct1" text:id="ct1"><text:insertion><office:change-info><dc:creator>Léa Roy</dc:creator><dc:date>2026-03-02T09:30:00</dc:date></office:change-info></text:insertion></text:changed-region>
   <text:changed-region xml:id="ct2" text:id="ct2"><text:deletion><office:change-info><dc:creator>Léa Roy</dc:creator><dc:date>2026-03-02T09:31:00</dc:date></office:change-info><text:p text:style-name="Standard">provisoirement </text:p></text:deletion></text:changed-region>
  </text:tracked-changes>
  <text:p text:style-name="Droite">Saint-Aubin, le <text:date style:data-style-name="N36" text:date-value="2026-03-01">01/03/2026</text:date></text:p>
  <text:h text:style-name="Heading_20_1" text:outline-level="1">Travaux de la salle des fêtes</text:h>
  <text:p text:style-name="Justifie">Madame, Monsieur, la salle des fêtes sera <text:change text:change-id="ct2"/>fermée du <text:span text:style-name="Gras">3 au 21 avril</text:span><text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Standard">Dates sous réserve de la météo.</text:p></text:note-body></text:note> pour <text:change-start text:change-id="ct1"/>d’importants <text:change-end text:change-id="ct1"/>travaux de toiture<text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p text:style-name="Standard">Délibération du 12 février.</text:p></text:note-body></text:note>.</text:p>
  <text:p text:style-name="Standard">Les activités sont <office:annotation office:name="c1"><dc:creator>Paul Meyer</dc:creator><dc:date>2026-03-02T11:00:00</dc:date><text:p>Vérifier avec le club de danse.</text:p></office:annotation>déplacées au gymnase<office:annotation-end office:name="c1"/> ; voir <text:a xlink:type="simple" xlink:href="https://exemple.org/travaux">le calendrier</text:a> et <text:span text:style-name="Ital">les horaires</text:span>.</text:p>
  <text:list text:style-name="Puces"><text:list-item><text:p text:style-name="Standard">Danse : lundi</text:p><text:list><text:list-item><text:p text:style-name="Standard">Débutants à 18 h</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="Standard">Théâtre : jeudi</text:p></text:list-item></text:list>
  <text:list text:style-name="Numeros"><text:list-item><text:p text:style-name="Standard">Dépose des tuiles</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">Charpente</text:p><text:list><text:list-item><text:p text:style-name="Standard">Traitement</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="Standard">Couverture</text:p></text:list-item></text:list>
  <table:table table:name="Tab1" table:style-name="Tab1"><table:table-column table:style-name="Tab1.A"/><table:table-column table:style-name="Tab1.B"/>
   <table:table-header-rows><table:table-row><table:table-cell table:style-name="Tab1.A1" office:value-type="string"><text:p text:style-name="Standard">Poste</text:p></table:table-cell><table:table-cell table:style-name="Tab1.A1" office:value-type="string"><text:p text:style-name="Standard">Coût</text:p></table:table-cell></table:table-row></table:table-header-rows>
   <table:table-row><table:table-cell table:style-name="Tab1.A2" office:value-type="string"><text:p text:style-name="Standard">Toiture</text:p></table:table-cell><table:table-cell table:style-name="Tab1.A2" office:value-type="string"><text:p text:style-name="Droite">48 000 €</text:p></table:table-cell></table:table-row>
  </table:table>
  <text:p text:style-name="Standard"><draw:frame draw:style-name="fr1" draw:name="Plan" text:anchor-type="as-char" svg:width="4.5cm" svg:height="3cm"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAFoAAAA8CAIAAABpZzoSAAAAYklEQVR42u3QQQ0AAAgEoCtnDnPbxp8lZCMBmS5OFOjQoUOHDh06dOjQoUOHDh06dOjQoQMdOnTo0KFDhw4dOnTo0KFDhw4dOnToQIcOHTp06NChQ4cOHTp06NChQ4cOHX8te8Fmimh3THIAAAAASUVORK5CYII=</office:binary-data></draw:image><svg:title>Plan de la salle</svg:title></draw:frame></text:p>
  <text:p text:style-name="Standard">Veuillez agréer nos salutations.<text:tab/>Le maire</text:p>
 </office:text></office:body>
